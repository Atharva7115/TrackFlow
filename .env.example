# ============================================================
# CareerPilot — Optional Environment Configuration
# ============================================================
# If .env is absent, sensible defaults will automatically be used.
#
# --- Gmail Ingestion Configuration ---
# GMAIL_QUERY=newer_than:30d
# GMAIL_MAX_RESULTS=20
# GMAIL_CREDENTIALS_PATH=./credentials.json
# GMAIL_TOKEN_PATH=./token.json

GMAIL_QUERY=newer_than:30d
GMAIL_MAX_RESULTS=20

# --- Phase 2: AI & Amazon Bedrock Configuration ---
# AWS Credentials can be provided via ~/.aws/credentials or environment variables:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= (optional)
#
# AWS Region for Amazon Bedrock & DynamoDB (default: us-east-1)
AWS_REGION=us-east-1

# Amazon Bedrock Model ID (default: us.anthropic.claude-3-haiku-20240307-v1:0)
# Other options: anthropic.claude-3-haiku-20240307-v1:0, amazon.nova-lite-v1:0, us.anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0

# Maximum number of emails to send to Bedrock per run for cost control (default: 5)
AI_MAX_EMAILS=5

# Maximum character limit for email bodies sent to Bedrock (default: 12000)
MAX_EMAIL_BODY_CHARS=12000

# --- Phase 3: Amazon DynamoDB Configuration ---
# DynamoDB table name (default: CareerPilot-Applications)
DYNAMODB_TABLE_NAME=CareerPilot-Applications
